---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import { getTagHue } from "@/utils/tagHue";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    data-hue={getTagHue(tagName)}
    class:list={[
      "group inline-flex items-center gap-1.5 rounded-full border transition-all duration-150",
      "border-border bg-muted/40 text-foreground",
      "hover:border-accent/60 hover:bg-accent/10 hover:text-accent",
      "focus-visible:text-accent focus-visible:border-accent",
      { "px-2.5 py-0.5 text-xs font-medium": size === "sm" },
      { "min-h-9 px-3 py-1.5 text-sm font-medium sm:min-h-0 sm:px-3.5": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-60 transition-opacity group-hover:opacity-100",
        { "size-4": size === "lg" },
        { "size-3.5": size === "sm" },
      ]}
    />
    <span>{tagName}</span>
    {
      count !== undefined && (
        <span class="bg-background/80 text-muted-foreground group-hover:text-accent rounded-full px-1.5 py-0.2 font-mono text-xs">
          {count}
        </span>
      )
    }
  </a>
</li>
