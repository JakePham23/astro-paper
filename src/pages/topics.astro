---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { BLOG_PATH } from "@/content.config";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const allPosts = await getCollection("posts", postFilter);

const FOLDER_LABELS: Record<string, { label: string; desc: string }> = {
  "00-root": {
    label: "00 · Tổng quan kho kiến thức",
    desc: "Điểm bắt đầu và bản đồ toàn bộ tài liệu.",
  },
  "01-claude-cli-multi-agent": {
    label: "01 · Claude CLI & Multi-Agent",
    desc: "CLI cơ bản, git worktree, subagent, workflow và prompt.",
  },
  "02-quy-trinh-phan-mem": {
    label: "02 · Quy trình phần mềm (SDLC)",
    desc: "Từ BRD, SRS/PRD, thiết kế, code review đến release & phê duyệt.",
  },
  "03-ap-dung-voi-agent": {
    label: "03 · Áp dụng với Agent",
    desc: "Agent làm gì ở từng giai đoạn và cách kiểm soát đầu ra.",
  },
  "04-mau": {
    label: "04 · Mẫu tài liệu (Templates)",
    desc: "Các template BRD, SRS, ADR, Test Plan, Release Checklist.",
  },
  "05-backend-senior": {
    label: "05 · Backend Senior",
    desc: "Auth, phân quyền, database, API, scale triệu user, Kafka, bảo mật.",
  },
  "06-database-chuyen-sau": {
    label: "06 · Database chuyên sâu",
    desc: "Postgres internals, index tuning, lock, replication, sharding, Redis.",
  },
  "07-he-thong-server": {
    label: "07 · Hệ thống & Server",
    desc: "Linux, network, load balancer, Docker, Kubernetes, CI/CD, sự cố.",
  },
  "08-aws-cloud": {
    label: "08 · AWS Cloud",
    desc: "IAM, VPC, compute, storage, edge, bảo mật, FinOps và Well-Architected.",
  },
  "09-rag-agent-code-intelligence": {
    label: "09 · RAG, Agent & Code Intelligence",
    desc: "LLM, RAG, Tree-sitter, symbol graph, A2A/MCP, governance.",
  },
  "10-review-sach": {
    label: "10 · Review Sách",
    desc: "Tóm tắt sách, key takeaways và trích dẫn hay.",
  },
};

type PostItem = {
  title: string;
  description: string;
  url: string;
  fileName: string;
  tags: string[];
};

const groupsMap = new Map<string, PostItem[]>();

for (const post of allPosts) {
  const rel = (post.filePath ?? "")
    .replace(BLOG_PATH, "")
    .replace(/^\/+/, "");
  const parts = rel.split("/").filter(Boolean);
  const folder = parts.length > 1 ? parts[0] : "00-root";
  const fileName = parts[parts.length - 1] ?? post.id;

  const list = groupsMap.get(folder) ?? [];
  list.push({
    title: post.data.title,
    description: post.data.description,
    url: getPostUrl(post.id, post.filePath, locale),
    fileName,
    tags: post.data.tags ?? [],
  });
  groupsMap.set(folder, list);
}

const groups = Array.from(groupsMap.entries())
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([folder, items]) => {
    items.sort((a, b) => a.fileName.localeCompare(b.fileName));
    const meta = FOLDER_LABELS[folder] ?? {
      label: folder,
      desc: "",
    };
    return {
      folder,
      label: meta.label,
      desc: meta.desc,
      items,
    };
  });
---

<Layout title={`Topics | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle="Knowledge Map"
    pageDesc={`Toàn bộ ${allPosts.length} bài viết được sắp xếp theo cây thư mục để bạn nhìn tổng quan và mở nhanh.`}
  >
    <!-- Quick filter + jump links -->
    <div class="mb-6 space-y-3 sm:mb-8 sm:space-y-4">
      <div class="relative">
        <input
          id="topic-filter"
          type="search"
          placeholder="Lọc nhanh bài viết theo tiêu đề, tên file hoặc tag..."
          class:list={[
            "w-full rounded-xl border px-4 py-3 text-base transition-colors sm:py-2.5 sm:text-sm",
            "border-border bg-muted/25 text-foreground placeholder:text-muted-foreground",
            "focus:border-accent focus:bg-background focus:outline-none",
          ]}
        />
      </div>

      <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0 sm:pb-0 [&::-webkit-scrollbar]:hidden">
        {
          groups.map(group => (
            <a
              href={`#folder-${group.folder}`}
              class:list={[
                "inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors sm:py-1",
                "border-border bg-muted/40 text-foreground",
                "hover:border-accent/60 hover:bg-accent/10 hover:text-accent",
              ]}
            >
              <span>{group.label}</span>
              <span class="text-muted-foreground font-mono">
                {group.items.length}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Folder hierarchy + sticky side TOC -->
    <div class="relative">
      <aside class="topics-toc" data-pagefind-ignore>
        <nav aria-label="Topics table of contents">
          <h2 class="topics-toc-label">Mục lục Topics</h2>
          <ol class="topics-toc-list">
            {
              groups.map(group => (
                <li data-toc-folder={group.folder}>
                  <a
                    href={`#folder-${group.folder}`}
                    class="topics-toc-link"
                    data-topics-toc-link={group.folder}
                  >
                    <span class="truncate">{group.label}</span>
                    <span class="topics-toc-count">{group.items.length}</span>
                  </a>
                </li>
              ))
            }
          </ol>
          <a href="#main-content" class="topics-toc-top">
            ↑ Lên đầu trang
          </a>
        </nav>
      </aside>

      <div id="topic-groups" class="space-y-6">
      {
        groups.map(group => (
          <section
            id={`folder-${group.folder}`}
            data-topic-group
            class="border-border bg-background scroll-mt-6 rounded-xl border p-4 sm:p-5"
          >
            <div class="border-border mb-3 flex flex-wrap items-baseline justify-between gap-2 border-b pb-2.5 sm:mb-4 sm:pb-3">
              <div>
                <h2 class="text-foreground text-base font-bold tracking-tight sm:text-lg">
                  {group.label}
                </h2>
                {group.desc && (
                  <p class="text-muted-foreground mt-0.5 text-xs">
                    {group.desc}
                  </p>
                )}
              </div>
              <span class="bg-muted/60 text-muted-foreground rounded-full px-2.5 py-0.5 font-mono text-xs">
                {group.items.length} bài
              </span>
            </div>

            <ul class="grid gap-1 sm:grid-cols-2 sm:gap-1.5">
              {group.items.map(item => (
                <li
                  data-topic-item
                  data-search={`${item.title} ${item.fileName} ${item.tags.join(" ")}`.toLowerCase()}
                >
                  <a
                    href={item.url}
                    class:list={[
                      "group flex items-start justify-between gap-2 rounded-lg px-2.5 py-2.5 transition-colors sm:px-3 sm:py-2",
                      "hover:bg-muted/40 active:bg-muted/50",
                    ]}
                  >
                    <div class="min-w-0">
                      <div class="text-foreground group-hover:text-accent line-clamp-2 text-sm leading-snug font-medium transition-colors sm:truncate">
                        {item.title}
                      </div>
                      <div class="text-muted-foreground mt-0.5 truncate font-mono text-[11px]">
                        {item.fileName}
                      </div>
                    </div>
                    {item.tags[0] && (
                      <span class="bg-muted/70 text-muted-foreground mt-0.5 hidden shrink-0 self-start rounded px-1.5 py-0.5 font-mono text-[11px] sm:inline-block">
                        #{item.tags[0]}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      </div>
    </div>

    <div class="mt-8 text-center">
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class="text-muted-foreground hover:text-accent text-sm underline decoration-dashed underline-offset-4"
      >
        ← Xem dạng danh sách thẻ bài viết (Posts)
      </a>
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  let cleanupScrollSpy: (() => void) | undefined;

  function initTopicsPage() {
    cleanupScrollSpy?.();
    cleanupScrollSpy = undefined;

    const input = document.getElementById(
      "topic-filter"
    ) as HTMLInputElement | null;
    const groups = Array.from(
      document.querySelectorAll<HTMLElement>("[data-topic-group]")
    );
    const tocItems = Array.from(
      document.querySelectorAll<HTMLElement>("[data-toc-folder]")
    );
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-topics-toc-link]")
    );

    if (input) {
      input.addEventListener("input", () => {
        const q = input.value.trim().toLowerCase();
        const visibleFolders = new Set<string>();

        for (const group of groups) {
          const items = Array.from(
            group.querySelectorAll<HTMLElement>("[data-topic-item]")
          );
          let visibleCount = 0;
          for (const item of items) {
            const text = item.dataset.search ?? "";
            const match = !q || text.includes(q);
            item.classList.toggle("hidden", !match);
            if (match) visibleCount++;
          }
          const isVisible = visibleCount > 0;
          group.classList.toggle("hidden", !isVisible);
          if (isVisible) {
            visibleFolders.add(group.id.replace("folder-", ""));
          }
        }

        for (const tocItem of tocItems) {
          const folder = tocItem.dataset.tocFolder ?? "";
          tocItem.classList.toggle("hidden", !visibleFolders.has(folder));
        }
      });
    }

    if (groups.length && tocLinks.length) {
      let frame = 0;
      const updateActive = () => {
        frame = 0;
        let activeFolder: string | null = null;
        for (const group of groups) {
          if (group.classList.contains("hidden")) continue;
          if (group.getBoundingClientRect().top <= 140) {
            activeFolder = group.id.replace("folder-", "");
          }
        }
        if (!activeFolder) {
          const firstVisible = groups.find(
            g => !g.classList.contains("hidden")
          );
          activeFolder = firstVisible
            ? firstVisible.id.replace("folder-", "")
            : null;
        }
        for (const link of tocLinks) {
          const isCurrent = link.dataset.topicsTocLink === activeFolder;
          if (isCurrent) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
      };

      const onScroll = () => {
        if (!frame) frame = requestAnimationFrame(updateActive);
      };

      updateActive();
      window.addEventListener("scroll", onScroll, { passive: true });
      cleanupScrollSpy = () => {
        window.removeEventListener("scroll", onScroll);
        if (frame) cancelAnimationFrame(frame);
      };
    }
  }

  document.addEventListener("astro:page-load", initTopicsPage);
</script>

<style>
  .topics-toc {
    display: none;
  }

  .topics-toc > nav {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 4rem);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .topics-toc-label {
    flex-shrink: 0;
    padding-block-end: 0.5rem;
    margin-block-end: 0.5rem;
    border-block-end: 1px dashed var(--color-border);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-foreground);
  }

  .topics-toc-list {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .topics-toc-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    border-radius: 0.375rem;
    color: var(--color-muted-foreground);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .topics-toc-link:hover {
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-muted) 45%, transparent);
  }

  .topics-toc-link[aria-current="true"] {
    color: var(--color-accent);
    font-weight: 600;
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .topics-toc-count {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.75;
  }

  .topics-toc-top {
    flex-shrink: 0;
    margin-block-start: 0.5rem;
    padding-block-start: 0.5rem;
    border-block-start: 1px dashed var(--color-border);
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
  }

  .topics-toc-top:hover {
    color: var(--color-accent);
  }

  @media (min-width: 80rem) {
    .topics-toc {
      display: block;
      position: absolute;
      inset-block: 0;
      inset-inline-start: 100%;
      --toc-space: calc((100vw - 100%) / 2);
      --toc-gap: clamp(0.75rem, calc(var(--toc-space) - 14.5rem), 2.5rem);
      --toc-edge: clamp(0.75rem, calc(var(--toc-space) - 15.5rem), 1.5rem);
      margin-inline-start: var(--toc-gap);
      width: min(
        16rem,
        calc(var(--toc-space) - var(--toc-gap) - var(--toc-edge))
      );
      container-type: inline-size;
    }

    @container (width < 7.5rem) {
      .topics-toc > nav {
        display: none;
      }
    }
  }
</style>
