---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import {
  getPostFolderAndFile,
  getPostsByLocale,
  normalizeLocale,
} from "@/utils/i18nPosts";
import { getTopicMeta } from "@/i18n/topics";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  currentId: string;
  currentFilePath?: string;
};

const { currentId, currentFilePath } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);

const current = getPostFolderAndFile(currentFilePath, currentId);
const allPosts = await getPostsByLocale(locale, postFilter);

const siblingPosts = allPosts
  .map(p => {
    const meta = getPostFolderAndFile(p.filePath, p.id);
    return {
      id: p.id,
      title: p.data.title,
      url: getPostUrl(p.id, p.filePath, locale),
      folder: meta.folder,
      fileName: meta.fileName,
    };
  })
  .filter(p => p.folder === current.folder)
  .sort((a, b) => a.fileName.localeCompare(b.fileName));

const folderLabel = getTopicMeta(current.folder, locale).shortLabel;
const currentIndex = siblingPosts.findIndex(p => p.id === currentId) + 1;
---

{
  siblingPosts.length > 0 && (
    <>
      <details
        class="post-sidebar-mobile border-border bg-muted/25 mb-5 rounded-xl border xl:hidden"
        data-pagefind-ignore
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-4 py-3 text-sm font-semibold">
          <span class="truncate">{folderLabel}</span>
          <span class="flex shrink-0 items-center gap-2">
            <span class="bg-background/80 text-muted-foreground rounded-full px-2 py-0.5 font-mono text-xs">
              {currentIndex}/{siblingPosts.length}
            </span>
            <span class="post-sidebar-chevron text-muted-foreground text-xs transition-transform">
              ▾
            </span>
          </span>
        </summary>
        <div class="border-border/80 space-y-1 border-t px-2 py-2">
          <ol class="max-h-64 space-y-1 overflow-y-auto overscroll-contain">
            {siblingPosts.map(item => {
              const isCurrent = item.id === currentId;
              return (
                <li>
                  <a
                    href={item.url}
                    aria-current={isCurrent ? "page" : undefined}
                    class:list={[
                      "block rounded-lg px-3 py-2 text-sm transition-colors",
                      isCurrent
                        ? "bg-accent/10 text-accent font-semibold"
                        : "text-muted-foreground hover:bg-muted/40 hover:text-accent",
                    ]}
                  >
                    {item.title}
                  </a>
                </li>
              );
            })}
          </ol>
          <div class="border-border/60 border-t px-2 pt-2 pb-1">
            <a
              href={getRelativeLocaleUrl(locale, "topics")}
              class="text-muted-foreground hover:text-accent inline-block py-1 text-xs"
            >
              {t.sidebar.allTopicsLink}
            </a>
          </div>
        </div>
      </details>

      <aside class="post-sidebar-left" data-pagefind-ignore>
        <nav aria-label="Chapter navigation">
          <div class="sidebar-header">
            <a
              href={getRelativeLocaleUrl(locale, "topics")}
              class="sidebar-all-link"
            >
              {t.sidebar.knowledgeMapLink}
            </a>
            <h2 class="sidebar-title">{folderLabel}</h2>
          </div>

          <ol class="sidebar-list">
            {siblingPosts.map(item => {
              const isCurrent = item.id === currentId;
              return (
                <li>
                  <a
                    href={item.url}
                    aria-current={isCurrent ? "page" : undefined}
                    class:list={["sidebar-link", { "is-active": isCurrent }]}
                  >
                    {item.title}
                  </a>
                </li>
              );
            })}
          </ol>
        </nav>
      </aside>
    </>
  )
}

<style>
  .post-sidebar-mobile[open] .post-sidebar-chevron {
    transform: rotate(180deg);
  }
  .post-sidebar-mobile summary::-webkit-details-marker {
    display: none;
  }

  .post-sidebar-left {
    display: none;
  }

  .post-sidebar-left > nav {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - 4rem);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .sidebar-header {
    flex-shrink: 0;
    padding-block-end: 0.625rem;
    margin-block-end: 0.5rem;
    border-block-end: 1px dashed var(--color-border);
  }

  .sidebar-all-link {
    display: inline-block;
    margin-block-end: 0.375rem;
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
    transition: color 0.15s ease;
  }

  .sidebar-all-link:hover {
    color: var(--color-accent);
  }

  .sidebar-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-foreground);
  }

  .sidebar-list {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-inline-end: 0.25rem;
  }

  .sidebar-link {
    display: block;
    padding: 0.3rem 0.5rem;
    border-radius: 0.375rem;
    color: var(--color-muted-foreground);
    overflow-wrap: anywhere;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .sidebar-link:hover {
    color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-muted) 45%, transparent);
  }

  .sidebar-link.is-active {
    color: var(--color-accent);
    font-weight: 600;
    background-color: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  @media (min-width: 80rem) {
    .post-sidebar-left {
      display: block;
      position: absolute;
      inset-block: 0;
      inset-inline-end: 100%;
      --sidebar-space: calc((100vw - 100%) / 2);
      --sidebar-gap: clamp(0.75rem, calc(var(--sidebar-space) - 14.5rem), 2.5rem);
      --sidebar-edge: clamp(0.75rem, calc(var(--sidebar-space) - 15.5rem), 1.5rem);
      margin-inline-end: var(--sidebar-gap);
      width: min(
        16rem,
        calc(var(--sidebar-space) - var(--sidebar-gap) - var(--sidebar-edge))
      );
      container-type: inline-size;
    }

    @container (width < 7.5rem) {
      .post-sidebar-left > nav {
        display: none;
      }
    }
  }

  @media print {
    .post-sidebar-left {
      display: none !important;
    }
  }
</style>
